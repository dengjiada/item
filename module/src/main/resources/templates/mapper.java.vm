package ${package.Mapper};

import ${package.Entity}.${entity};
import org.apache.ibatis.annotations.Mapper;
import org.apache.ibatis.annotations.Param;
import org.apache.ibatis.annotations.Select;
import org.apache.ibatis.annotations.Update;

/**
 * <p>
 * $!{table.comment} Mapper 接口
 * </p>
 *
 * @author ${author}
 * @since ${date}
 */
@Mapper
public interface ${table.mapperName} {

    //根据id查询详情，需要判断逻辑删除标记（is_deleted）
    @Select("select * from ${table.name} where id = #{id} and is_deleted = 0")
    ${entity} getById(@Param(value = "id") Long id);

    //根据id查询详情，不需要判断逻辑删除标记（is_deleted）
    @Select("select * from ${table.name} where id = #{id}")
    ${entity} extractById(@Param(value = "id") Long id);

    //新增
    int insert(@Param(value = "entity") ${entity} entity);

    //修改
    int update(@Param(value = "entity") ${entity} entity);

    //根据id逻辑删除
    @Update("update ${table.name} set is_deleted = 1,update_time = #{timeStamp} where id = #{id} and is_deleted = 0 limit 1")
    int delete(@Param(value = "id") Long id, @Param(value = "timeStamp") int timeStamp);
}
