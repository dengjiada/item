package ${package.Controller};

import org.springframework.web.bind.annotation.*;
import org.springframework.beans.factory.annotation.Autowired;
import ${modulePkg}.entity.${entity};
import ${modulePkg}.service.${table.serviceName};

/**
 * <p>
 * $!{table.comment} 前端控制器
 * </p>
 *
 * @author ${author}
 * @since ${date}
 */
@RestController
public class ${table.controllerName} {
    @Autowired
    private ${table.serviceName} ${table.serviceName.substring(0,1).toLowerCase()}${table.serviceName.substring(1)};

    @RequestMapping("/${table.name}/info")
    public ${entity} getInfo(@RequestParam(required = true) Long id){
        return ${table.serviceName.substring(0,1).toLowerCase()}${table.serviceName.substring(1)}.getById(id);
    }

    @RequestMapping("/${table.name}/details" )
    public ${entity} getDetails(@RequestParam(required = true) Long id) {
        return ${table.serviceName.substring(0,1).toLowerCase()}${table.serviceName.substring(1)}.extractById(id);
    }

    @PostMapping("/${table.name}/create")
    public String create(@RequestBody ${entity} entity){
        int rows = ${table.serviceName.substring(0,1).toLowerCase()}${table.serviceName.substring(1)}.insert(entity);
        return rows > 0 ? "成功" : "失败";
    }

    @PostMapping("/${table.name}/update")
    public String update(@RequestBody ${entity} entity){
        int rows = ${table.serviceName.substring(0,1).toLowerCase()}${table.serviceName.substring(1)}.update(entity);
        return rows > 0 ? "成功" : "失败";
    }

    @RequestMapping("/${table.name}/delete")
    public String delete(@RequestParam(required = true) Long id){
        int rows = ${table.serviceName.substring(0,1).toLowerCase()}${table.serviceName.substring(1)}.delete(id);
        return rows > 0 ? "成功" : "失败";
    }
}