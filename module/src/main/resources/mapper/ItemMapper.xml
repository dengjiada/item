<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace 必须对应Mapper接口全类名 -->
<mapper namespace="com.tianzhou.item.module.mapper.ItemMapper">
    <insert id="createItem" parameterType="com.tianzhou.item.module.entity.Item" useGeneratedKeys="true"
            keyProperty="id">
        insert into item(
        <if test="item.coverImages != null and item.coverImages != ''">cover_images,</if>
        <if test="item.name != null and item.name != ''">name,</if>
        <if test="item.price != null">price,</if>
        <if test="item.introduction != null and item.introduction != ''">introduction,</if>
        <if test="item.createTime != null">create_time,</if>
        <if test="item.updateTime != null">update_time,</if>
        <if test="item.isDeleted != null">is_deleted</if>)
        values (
        <if test="item.coverImages != null and item.coverImages != ''">#{item.coverImages},</if>
        <if test="item.name != null and item.name != ''">#{item.name},</if>
        <if test="item.price != null">#{item.price},</if>
        <if test="item.introduction != null and item.introduction != ''">#{item.introduction},</if>
        <if test="item.createTime != null">#{item.createTime},</if>
        <if test="item.updateTime != null">#{item.updateTime},</if>
        <if test="item.isDeleted != null">#{item.isDeleted}</if>
        )
    </insert>

    <update id="updateItem" parameterType="com.tianzhou.item.module.entity.Item">
        update item
        <set>
            <if test="item.coverImages != null and item.coverImages != ''">cover_images = #{item.coverImages},</if>
            <if test="item.name != null and item.name != ''">name = #{item.name},</if>
            <if test="item.price != null">price = #{item.price},</if>
            <if test="item.introduction != null and item.introduction != ''">introduction = #{item.introduction},</if>
            <if test="item.updateTime != null">update_time = #{item.updateTime}</if>
        </set>
        where id = #{item.id}
    </update>

    <select id="selectPage" parameterType="java.util.Map" resultType="com.tianzhou.item.module.entity.Item">
        select id, cover_images, name, price
        from item
        where is_deleted = 0
        <if test="keyword != null and keyword != ''">
            and name like concat('%', #{keyword}, '%')
        </if>
        order by id
        limit #{offset},#{pageSize}
    </select>
</mapper>