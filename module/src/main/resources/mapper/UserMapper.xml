<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tianzhou.item.module.mapper.UserMapper">
    <insert id="insert" parameterType="com.tianzhou.item.module.entity.User" useGeneratedKeys="true" keyProperty="id">
        insert into user
        <trim prefix="(" suffix=")" suffixOverrides=",">
                    <if test="entity.phone != null and entity.phone != ''">
                        phone,
                    </if>
                    <if test="entity.password != null and entity.password != ''">
                        password,
                    </if>
                    <if test="entity.salt != null and entity.salt != ''">
                        salt,
                    </if>
                    <if test="entity.name != null and entity.name != ''">
                        name,
                    </if>
                    <if test="entity.avatar != null and entity.avatar != ''">
                        avatar,
                    </if>
                    <if test="entity.createTime != null">
                        create_time,
                    </if>
                    <if test="entity.updateTime != null">
                        update_time,
                    </if>
                    <if test="entity.isDeleted != null">
                        is_deleted,
                    </if>
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
                    <if test="entity.phone != null and entity.phone != ''">
                        #{entity.phone},
                    </if>
                    <if test="entity.password != null and entity.password != ''">
                        #{entity.password},
                    </if>
                    <if test="entity.salt != null and entity.salt != ''">
                        #{entity.salt},
                    </if>
                    <if test="entity.name != null and entity.name != ''">
                        #{entity.name},
                    </if>
                    <if test="entity.avatar != null and entity.avatar != ''">
                        #{entity.avatar},
                    </if>
                    <if test="entity.createTime != null">
                        #{entity.createTime},
                    </if>
                    <if test="entity.updateTime != null">
                        #{entity.updateTime},
                    </if>
                    <if test="entity.isDeleted != null">
                        #{entity.isDeleted},
                    </if>
        </trim>
    </insert>

    <update id="update" parameterType="com.tianzhou.item.module.entity.User">
        update user
        <set>
                    <if test="entity.phone != null and entity.phone != ''">
                        phone = #{entity.phone},
                    </if>
                    <if test="entity.password != null and entity.password != ''">
                        password = #{entity.password},
                    </if>
                    <if test="entity.salt != null and entity.salt != ''">
                        salt = #{entity.salt},
                    </if>
                    <if test="entity.name != null and entity.name != ''">
                        name = #{entity.name},
                    </if>
                    <if test="entity.avatar != null and entity.avatar != ''">
                        avatar = #{entity.avatar},
                    </if>
                    <if test="entity.createTime != null">
                        create_time = #{entity.createTime},
                    </if>
                    <if test="entity.updateTime != null">
                        update_time = #{entity.updateTime},
                    </if>
                    <if test="entity.isDeleted != null">
                        is_deleted = #{entity.isDeleted},
                    </if>
        </set>
        where id = #{entity.id}
    </update>
</mapper>