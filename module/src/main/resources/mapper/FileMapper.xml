<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tianzhou.item.module.mapper.FileMapper">
    <insert id="insert" parameterType="com.tianzhou.item.module.entity.File" useGeneratedKeys="true" keyProperty="id">
        insert into file
        <trim prefix="(" suffix=")" suffixOverrides=",">
                    <if test="entity.type != null">
                        type,
                    </if>
                    <if test="entity.originalName != null and entity.originalName != ''">
                        original_name,
                    </if>
                    <if test="entity.objectName != null and entity.objectName != ''">
                        object_name,
                    </if>
                    <if test="entity.url != null and entity.url != ''">
                        url,
                    </if>
                    <if test="entity.createTime != null">
                        create_time,
                    </if>
                    <if test="entity.updateTime != null">
                        update_time,
                    </if>
                    <if test="entity.isDeleted != null">
                        is_deleted,
                    </if>
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
                    <if test="entity.type != null">
                        #{entity.type},
                    </if>
                    <if test="entity.originalName != null and entity.originalName != ''">
                        #{entity.originalName},
                    </if>
                    <if test="entity.objectName != null and entity.objectName != ''">
                        #{entity.objectName},
                    </if>
                    <if test="entity.url != null and entity.url != ''">
                        #{entity.url},
                    </if>
                    <if test="entity.createTime != null">
                        #{entity.createTime},
                    </if>
                    <if test="entity.updateTime != null">
                        #{entity.updateTime},
                    </if>
                    <if test="entity.isDeleted != null">
                        #{entity.isDeleted},
                    </if>
        </trim>
    </insert>

    <update id="update" parameterType="com.tianzhou.item.module.entity.File">
        update file
        <set>
                    <if test="entity.type != null">
                        type = #{entity.type},
                    </if>
                    <if test="entity.originalName != null and entity.originalName != ''">
                        original_name = #{entity.originalName},
                    </if>
                    <if test="entity.objectName != null and entity.objectName != ''">
                        object_name = #{entity.objectName},
                    </if>
                    <if test="entity.url != null and entity.url != ''">
                        url = #{entity.url},
                    </if>
                    <if test="entity.createTime != null">
                        create_time = #{entity.createTime},
                    </if>
                    <if test="entity.updateTime != null">
                        update_time = #{entity.updateTime},
                    </if>
                    <if test="entity.isDeleted != null">
                        is_deleted = #{entity.isDeleted},
                    </if>
        </set>
        where id = #{entity.id}
    </update>
</mapper>